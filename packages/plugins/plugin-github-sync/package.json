{
  "name": "@paperclipai/plugin-github-sync",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "First-party PaperclipAI plugin that syncs GitHub repositories, issues, pull requests, commits, branches, labels, workflow/check statuses, and review activity into the Paperclip control plane. GitHub remains the source of truth for code state.",
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "github",
    "sync",
    "integration",
    "control-plane"
  ],
  "author": "Paperclip",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.27.3",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
